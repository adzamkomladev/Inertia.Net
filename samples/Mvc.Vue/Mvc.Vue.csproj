<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- What a package consumer gets from buildTransitive/: global usings for Inertia.Net and its static Inertia class. -->
  <Import Project="..\..\src\Inertia.Net\buildTransitive\Inertia.Net.props" />
  <PropertyGroup>
    <RootNamespace>Mvc.Vue</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Inertia.Net\Inertia.Net.csproj" />
    <ProjectReference Include="..\..\src\Inertia.Net.Mvc\Inertia.Net.Mvc.csproj" />
  </ItemGroup>
  <!-- The frontend is built separately (npm run build); dotnet build never needs Node. -->
  <ItemGroup>
    <Content Remove="node_modules\**;ClientApp\**;package*.json;tsconfig*.json" />
    <None Remove="node_modules\**;ClientApp\**" />
  </ItemGroup>
</Project>
