<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- What a package consumer gets from buildTransitive/: global usings for Inertia.Net and its static Inertia class. -->
  <Import Project="..\..\src\Inertia.Net\buildTransitive\Inertia.Net.props" />
  <PropertyGroup>
    <RootNamespace>Mvc.Vue</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Inertia.Net\Inertia.Net.csproj" />
    <ProjectReference Include="..\..\src\Inertia.Net.Mvc\Inertia.Net.Mvc.csproj" />
    <ProjectReference Include="..\..\src\Inertia.Net.EntityFrameworkCore\Inertia.Net.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <ProjectReference Include="..\..\src\Inertia.Net.Live.SignalR\Inertia.Net.Live.SignalR.csproj" />
    <ProjectReference Include="..\..\src\Inertia.Net.Live.Sse\Inertia.Net.Live.Sse.csproj" />
    <!-- LIVE_BACKPLANE=redis|postgres: live props across several instances. -->
    <ProjectReference Include="..\..\src\Inertia.Net.Redis\Inertia.Net.Redis.csproj" />
    <ProjectReference Include="..\..\src\Inertia.Net.Postgres\Inertia.Net.Postgres.csproj" />
  </ItemGroup>
  <!-- The frontend is built separately (npm run build); dotnet build never needs Node. -->
  <ItemGroup>
    <Content Remove="node_modules\**;ClientApp\**;ssr\**;package*.json;tsconfig*.json" />
    <None Remove="node_modules\**;ClientApp\**;ssr\**" />
  </ItemGroup>
</Project>
