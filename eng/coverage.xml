<?xml version="1.0" encoding="utf-8"?>
<!-- The library assemblies only: tests, samples and the AOT/benchmark apps are not measured. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Inertia\.Net(\.[A-Za-z.]+)?\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
        <ModulePath>.*Inertia\.Net\.Analyzers\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
