{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["resources/js", "vite.config.ts"],
  "exclude": ["resources/js/shared/compute.ts", "resources/js/shared/data.ts", "resources/js/shared/server.ts"]
}
