# Production settings for the benchmark (copied to .env in the image; DB_HOST and REDIS_HOST come from run.sh).
APP_NAME=Bench
APP_ENV=production
APP_DEBUG=false
# Filled in by `php artisan key:generate` in the Dockerfile.
APP_KEY=
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bench
DB_USERNAME=bench
DB_PASSWORD=bench
# The other apps keep no session, so the session lives in memory for the request (the web middleware still runs).
SESSION_DRIVER=array
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OCTANE_SERVER=frankenphp
