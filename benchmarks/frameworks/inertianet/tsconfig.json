{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["ClientApp", "vite.config.ts"],
  "exclude": ["ClientApp/shared/compute.ts", "ClientApp/shared/data.ts", "ClientApp/shared/server.ts"]
}
