<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- What a package consumer gets from buildTransitive/: global usings for Inertia.Net and its static Inertia class. -->
  <Import Project="..\..\..\src\Inertia.Net\buildTransitive\Inertia.Net.props" />
  <PropertyGroup>
    <RootNamespace>InertiaNetBench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- The Dockerfile's aot target publishes with -p:PublishAot=true; the trim and AOT analyzers run in every build. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Inertia.Net\Inertia.Net.csproj" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <!-- The frontend is built separately (npm run build, in the Dockerfile); dotnet build never needs Node. -->
  <ItemGroup>
    <Content Remove="node_modules\**;ClientApp\**;ssr\**;wwwroot\**;package*.json" />
    <None Remove="node_modules\**;ClientApp\**;ssr\**;app.html" />
    <Content Include="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
