<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.7.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Inertia.Net contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adzamkomladev/Inertia.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adzamkomladev/Inertia.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>inertia inertiajs aspnetcore react vue svelte spa minimal-api fastendpoints</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <!-- Templates pack source files without a library API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" Condition="'$(MSBuildProjectName)' != 'Inertia.Net.Templates'" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
