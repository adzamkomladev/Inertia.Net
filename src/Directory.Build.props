<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Inertia.Net contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- TODO: replace OWNER with the real GitHub owner/org before first release. -->
    <PackageProjectUrl>https://github.com/OWNER/Inertia.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OWNER/Inertia.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>inertia inertiajs aspnetcore react vue svelte spa minimal-api fastendpoints</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
