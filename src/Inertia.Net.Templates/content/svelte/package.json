{
  "name": "inertiastarter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "dotnet run -- --inertia-types",
    "build": "svelte-check --tsgo --tsconfig ./tsconfig.json && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@inertiajs/svelte": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@microsoft/signalr": "^10.0.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
