{
  "$schema": "http://json.schemastore.org/template",
  "author": "Inertia.Net contributors",
  "classifications": [
    "Web",
    "Inertia",
    "React",
    "Vue",
    "Svelte",
    "Vite"
  ],
  "identity": "Inertia.Net.App",
  "name": "Inertia.Net app",
  "description": "An ASP.NET Core Minimal API app with an Inertia.js v3 client (React, Vue or Svelte) built with Vite.",
  "shortName": "inertia",
  "sourceName": "InertiaStarter",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "react",
      "description": "The client-side framework.",
      "choices": [
        {
          "choice": "react",
          "description": "React 19 with @inertiajs/react"
        },
        {
          "choice": "vue",
          "description": "Vue 3 with @inertiajs/vue3"
        },
        {
          "choice": "svelte",
          "description": "Svelte 5 with @inertiajs/svelte"
        }
      ]
    },
    "tfm": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "replaces": "net10.0",
      "description": "The target framework.",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10 (LTS)"
        },
        {
          "choice": "net11.0",
          "description": ".NET 11 (STS)"
        }
      ]
    },
    "auth": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Adds cookie sign-in: a login page with a demo user, a protected dashboard, logout and a sign-in rate limit."
    }
  },
  "sources": [
    {
      "source": "./common/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(auth)",
          "exclude": [
            "ClientApp/types/**"
          ]
        }
      ]
    },
    {
      "source": "./react/",
      "target": "./",
      "condition": "(framework == \"react\")",
      "modifiers": [
        {
          "condition": "(auth)",
          "exclude": [
            "ClientApp/Layout.tsx"
          ]
        }
      ]
    },
    {
      "source": "./vue/",
      "target": "./",
      "condition": "(framework == \"vue\")",
      "modifiers": [
        {
          "condition": "(auth)",
          "exclude": [
            "ClientApp/Layout.vue"
          ]
        }
      ]
    },
    {
      "source": "./svelte/",
      "target": "./",
      "condition": "(framework == \"svelte\")",
      "modifiers": [
        {
          "condition": "(auth)",
          "exclude": [
            "ClientApp/Layout.svelte"
          ]
        }
      ]
    },
    {
      "source": "./auth/common/",
      "target": "./",
      "condition": "(auth)"
    },
    {
      "source": "./auth/react/",
      "target": "./",
      "condition": "(auth && framework == \"react\")"
    },
    {
      "source": "./auth/vue/",
      "target": "./",
      "condition": "(auth && framework == \"vue\")"
    },
    {
      "source": "./auth/svelte/",
      "target": "./",
      "condition": "(auth && framework == \"svelte\")"
    }
  ],
  "primaryOutputs": [
    {
      "path": "InertiaStarter.csproj"
    }
  ]
}
