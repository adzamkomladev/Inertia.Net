<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Inertia.Net.FastEndpoints</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>FastEndpoints integration for Inertia.Net.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
  </ItemGroup>
  <ItemGroup>
    <!-- FastEndpoints 9 (net11.0) made Void a struct: the three Task<Void> signatures are declared per framework. -->
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inertia.Net\Inertia.Net.csproj" />
  </ItemGroup>
</Project>
